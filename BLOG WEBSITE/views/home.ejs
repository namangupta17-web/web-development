<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOG WEBSITE</title>
    <link rel="stylesheet" href="styles/footer.css">
     <link rel="stylesheet" href="styles/header.css">
    <link rel="stylesheet" href="styles/style.css">
</head>
<header>
    <%- include("partials/header.ejs")%>
</header>

<body>
    <main>
        <% for(var  i=0;i<20;i++){%>
            <section class="blog-container">
            <article class="blog-card">
            <div class="card-header">
            <span class="blog-author"><%=data[i].author%></span>
            <span class="blog-date"><%=data[i].date%></span>
            </div>
            <h2 class="blog-title"><%=data[i].title%></h2>
            <div class="card-content">
            <div class="image-wrapper">
            <img src="<%=data[i].image%>" alt="Blog thumbnail">
            </div>
            <div class="text-wrapper">
            <p>
               <%=data[i].excerpt%>
            <form action="/submit" method="POST">
                 <input type="hidden" name="blogIndex" value="<%= i %>"> <button type="submit" class="read-more">read more</button>
            </form>
           
            </p>
            </div>
            </div>
            </article>
            </section>
     
    </main>
   <%}%>
</body>
<footer>
    <%- include("partials/footer.ejs")%>
</footer>
</html>